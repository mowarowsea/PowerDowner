{
  "name": "powerdowner",
  "version": "0.1.0",
  "private": true,
  "description": "URL を投げるだけの自宅用ダウンロード司令塔 (aria2 + JDownloader2)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --no-warnings=ExperimentalWarning --import tsx --watch src/index.ts",
    "start": "node --no-warnings=ExperimentalWarning --import tsx src/index.ts",
    "test": "node --no-warnings=ExperimentalWarning --import tsx --test \"src/**/*.test.ts\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "fastify": "^5.12.3",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.23.13",
    "typescript": "^5.9"
  }
}
